# Keep the real copy on the VPS at /etc/tratosapp/api.env; do not commit secrets.
DATABASE_URL=mongodb+srv://USER:PASSWORD@HOST/DATABASE
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
ALLOW_ORIGIN=https://YOUR-VERCEL-PROJECT.vercel.app
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
SEED_ADMIN_NAME=Tratosapp Admin
